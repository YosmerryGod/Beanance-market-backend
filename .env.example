PORT=3030
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=warn
CORS_ORIGIN=*
BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binance.com/market/stream
BINANCE_RECONNECT_BASE_DELAY_MS=1000
BINANCE_RECONNECT_MAX_DELAY_MS=30000
MARKET_REFRESH_INTERVAL_MS=21600000
BINANCE_REST_TIMEOUT_MS=10000
BINANCE_REST_CONCURRENCY=2
BINANCE_REST_MAX_QUEUE=100
BINANCE_WEIGHT_BUDGET_PER_MINUTE=850
BINANCE_RATE_LIMIT_COOLDOWN_MS=60000
BINANCE_CACHE_MAX_ENTRIES=500
BINANCE_RETRY_5XX=1
DETAIL_CACHE_MAX_ENTRIES=300
DEPTH_CACHE_TTL_MS=500
TRADES_CACHE_TTL_MS=1000
METRICS_CACHE_TTL_MS=10000
KLINE_CACHE_TTL_MS=15000
WS_MAX_CLIENTS=100
WS_MAX_SUBSCRIPTIONS_PER_CLIENT=20
WS_MAX_ACTIVE_STREAMS=800
WS_MAX_BUFFERED_BYTES=1048576
WS_MARKET_BATCH_MS=500
WS_DEPTH_THROTTLE_MS=200
WS_HEARTBEAT_MS=30000
WS_STALE_TIMEOUT_MS=90000
WS_COMMAND_BATCH_SIZE=50
WS_IDLE_CLOSE_MS=30000
SQLITE_PATH=./data/beanance-market.db
SQLITE_CACHE_SIZE_KB=8192
SQLITE_KLINE_RETENTION_PER_PAIR=2000
SQLITE_MAX_KLINE_ROWS=300000
SQLITE_RETENTION_DAYS=30
SQLITE_MAX_PERSISTED_SYMBOLS=100
SQLITE_KLINE_INTERVALS=1m,5m,15m,1h,4h,1d
SQLITE_MAINTENANCE_INTERVAL_MS=3600000
SQLITE_MAX_DATABASE_MB=256
HTTP_RATE_LIMIT_MAX=120
HTTP_RATE_LIMIT_WINDOW=1 minute
